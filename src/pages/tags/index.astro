---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagCloud from '@/components/blog/TagCloud';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tagCount: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCount[tag] = (tagCount[tag] || 0) + 1;
  });
});
const tags = Object.entries(tagCount).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
---

<BaseLayout title="标签" description="浏览所有文章标签">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="font-serif-zh text-3xl md:text-4xl font-bold text-ink dark:text-ink-light mb-4">标签</h1>
      <p class="text-ink-gray-3">共 {tags.length} 个标签</p>
    </div>
    <TagCloud tags={tags} />
  </div>
</BaseLayout>
